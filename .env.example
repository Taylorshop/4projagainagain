# Server
PORT=3001
NODE_ENV=development

# Database
DATABASE_URL="postgresql://supfile:supfile@localhost:5432/supfile?schema=public"

# Auth – replace with strong random secrets in production
JWT_ACCESS_SECRET="change-me-access"
JWT_REFRESH_SECRET="change-me-refresh"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Local temp directory for multer uploads (blobs go to Azure, this is just for temp files)
STORAGE_ROOT="./storage"

# Azure Blob Storage — get your connection string from:
# Azure Portal → Storage Account → Access Keys → Connection string
# Leave empty to use the local Azurite emulator (started automatically by docker-compose)
AZURE_STORAGE_CONNECTION_STRING=""
# Name of the blob container (created automatically if it doesn't exist)
AZURE_STORAGE_CONTAINER="supfile"

# CORS & frontend URL
CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

# Google OAuth2
# Create credentials at https://console.cloud.google.com/
# Authorised redirect URI: http://localhost:3001/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/oauth/google/callback"
