CORS_ORIGIN="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3001/auth/oauth/google/callback"
